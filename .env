APP_NAME="API Bet Aki"
APP_ENV=local
APP_KEY=base64:MWaiDnbSycy0zNNnGwmOohBlnLO4fZEibPj1Dd7hfVs=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ===== API externa para dados de jogos ======
BASE_API_URL=https://betaki.bet.br/api
BASE_PORTAL_ID=5
BASE_API_TIMEOUT=20
BASE_API_KEY="e3d8ca29-c8a4-40c1-9246-94887777ed6a"

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===== Banco: PostgreSQL (serviço "db" no docker-compose) =====
DB_CONNECTION=pgsql
#DB_HOST=dbapibetaki.cluster-custom-cfass2k08qv5.us-east-2.rds.amazonaws.com
DB_HOST=localhost
DB_PORT=5432
#DB_DATABASE=dbbetakipg
DB_DATABASE=betaki
DB_USERNAME=betaki
#DB_PASSWORD=cX7Tu42zgivVy9z
DB_PASSWORD=betaki
# ===== Sessão =====
# Para API com Bearer tokens (Sanctum PAT), "file" é suficiente.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# ===== Cache & Queue =====
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
CACHE_STORE=file
QUEUE_CONNECTION=sync
REDIS_CLIENT=null

# ===== Redis (serviço "redis") =====
REDIS_CLIENT=phpredis
REDIS_HOST=localhost
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===== Broadcast/FS =====
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEMCACHED_HOST=127.0.0.1

# ===== Mail (dev) =====
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@betaki.bet.br"
MAIL_FROM_NAME="${APP_NAME}"

# ===== AWS (posterior) =====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===== Sanctum (compat SPA futura; não obrigatório para PAT) =====
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000
SESSION_COOKIE=laravel_session

# ===== Swagger (geração automática só em local) =====
L5_SWAGGER_GENERATE_ALWAYS=true
L5_FORMAT_TO_USE_FOR_DOCS=json

VITE_APP_NAME="${APP_NAME}"